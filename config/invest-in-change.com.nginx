# copy this to nginx sites-available, also modify etc/hosts

map $sent_http_content_type $expires {
    default                         off;
    text/html                       epoch;
    text/css                        epoch;
    application/javascript          epoch;
    ~image/                         epoch;
}

server {
	listen   80; ## listen for ipv4; this line is default and implied
	listen [::]:80;
	
	server_name invest-in-change.com www.invest-in-change.com localwww.invest-in-change.com;

#	ssl_certificate /etc/letsencrypt/live/winterwell.com-0002/fullchain.pem;
#	ssl_certificate_key /etc/letsencrypt/live/winterwell.com-0002/privkey.pem;
#	ssl_protocols TLSv1.2 TLSv1.3;
#	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
#	ssl_prefer_server_ciphers off;

	# TODO setup ssl
	# rewrite ^ https://$server_name$request_uri? permanent;
    
	expires $expires;

	root /home/winterwell/invest-in-change/webroot;
	index index.html;
    access_log      /var/log/nginx/invest-in-change.com/access.log;
    error_log       /var/log/nginx/invest-in-change.com/error.log;

	
	location / {
		autoindex on;
		try_files $uri $uri.html;
		add_header 'Access-Control-Allow-Origin' "$http_origin";
		add_header 'Access-Control-Allow-Credentials' 'true';
		add_header 'Cache-Control' 'no-cache';
	}
}
